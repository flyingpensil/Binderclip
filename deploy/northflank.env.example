# Configure as Northflank runtime variables / secret-group entries.
# Never paste real secrets into this committed example.
DEBUG=false
DEMO_LOGIN=false
PORT=8000
WEB_CONCURRENCY=1
# Northflank's managed ingress only. Do not expose Gunicorn directly.
TRUST_PROXY=true
# Set this after the HTTP public port has been assigned its HTTPS code.run domain.
APP_BASE_URL=https://YOUR-ASSIGNED-DOMAIN.code.run
# Secret: use a long random value generated directly in your hosting secret store.
SECRET_KEY=
# Secret: link PostgreSQL's POSTGRES_URI into DATABASE_URL via a secret group.
# Enable TLS on the addon and leave its public access disabled.
DATABASE_URL=
INITIAL_ADMIN_EMAIL=inventory.choco@gmail.com
INITIAL_ADMIN_NAME=Admin1
INITIAL_ADMIN_USERNAME=Admin1
INITIAL_COMPANY_NAME=Binderclip
# Secrets: configure the Google web client after the service hostname is assigned.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI is derived from APP_BASE_URL; normally leave it unset.
