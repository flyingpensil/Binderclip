FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8000 WEB_CONCURRENCY=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN useradd --create-home --uid 10001 binderclip
COPY --chown=binderclip:binderclip . .
RUN mkdir -p /app/staticfiles && chown binderclip:binderclip /app/staticfiles
USER binderclip
# Build-only settings: collect static assets without live secrets or a database.
# These values are not runtime environment variables.
RUN DEBUG=true SECRET_KEY=static-build-only python manage.py collectstatic --noinput
EXPOSE 8000
CMD ["sh", "scripts/start-hosted.sh"]
