# Docker Compose configuration. Local PowerShell environment setup is in README.md.
DEBUG=false
SECRET_KEY=replace-with-at-least-50-random-characters
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://erp.example.com
POSTGRES_DB=binderclip
POSTGRES_USER=binderclip
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://erp.example.com/auth/google/callback/
DEMO_LOGIN=false
# Only enable behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
# Render supplies DATABASE_URL automatically; it takes priority over POSTGRES_*.
# DATABASE_URL=postgresql://user:password@host:5432/binderclip
# APP_BASE_URL=https://your-actual-host.onrender.com
INITIAL_ADMIN_EMAIL=inventory.choco@gmail.com
INITIAL_ADMIN_NAME=Admin1
INITIAL_ADMIN_USERNAME=Admin1
INITIAL_COMPANY_NAME=Binderclip
